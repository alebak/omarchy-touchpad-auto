#!/bin/bash

# omarchy-touchpad-auto-internal
#
# Prints the Hyprland device name of the built-in touchpad, or prints
# nothing and exits non-zero if it cannot be determined unambiguously.
#
# Why this exists
# ----------------
# Omarchy's own `omarchy-hw-touchpad` resolves the touchpad this way:
#
#   hyprctl devices -j | jq -r '[.mice[] | .name
#     | select(test("touchpad|trackpad"; "i"))] | first'
#
# That picks whichever matching device Hyprland happened to enumerate first.
# With an external trackpad connected (e.g. an Apple Magic Trackpad, whose
# Hyprland name also matches /trackpad/i), it can return the WRONG device --
# and `omarchy-toggle-input-device touchpad off` would then disable the
# external trackpad while leaving the built-in one live. This is a confirmed
# upstream bug, filed as omacom/omarchy#12029.
#
# This script resolves the built-in touchpad independently, via udev physical
# integration data rather than a name substring match, so Service.qml can
# compare the two results and refuse to toggle anything when they disagree.
#
# Resolution
# ----------
# A device qualifies only when udev reports BOTH:
#   ID_INPUT_TOUCHPAD=1
#   ID_INPUT_TOUCHPAD_INTEGRATION=internal
#
# If zero or more than one /dev/input/event* node matches, this prints
# nothing and exits non-zero: an ambiguous match is not a safe answer.
#
# The Hyprland device name is derived from the matching event node's input
# device NAME (read from /sys/class/input/<event>/device/name, e.g. "SynPS/2
# Synaptics TouchPad"), lowercased with spaces replaced by hyphens, mirroring
# how Hyprland derives its own libinput device identifiers (e.g.
# "synps/2-synaptics-touchpad").
#
# Runs standalone, with no arguments, so it can be tested independently of the
# QML plugin: bin/omarchy-touchpad-auto-internal

set -euo pipefail

candidates=()

shopt -s nullglob
for dev in /dev/input/event*; do
  [[ -e $dev ]] || continue

  props=$(udevadm info --query=property --name="$dev" 2>/dev/null) || continue

  is_touchpad=0
  integration=""

  while IFS='=' read -r key value; do
    case "$key" in
      ID_INPUT_TOUCHPAD) is_touchpad=$value ;;
      ID_INPUT_TOUCHPAD_INTEGRATION) integration=$value ;;
    esac
  done <<<"$props"

  if [[ $is_touchpad == 1 && $integration == "internal" ]]; then
    candidates+=("$dev")
  fi
done
shopt -u nullglob

# Zero matches: no internal touchpad on this machine. More than one match: we
# cannot tell which one is THE built-in touchpad. Either way, refuse to guess.
if [[ ${#candidates[@]} -ne 1 ]]; then
  exit 1
fi

dev="${candidates[0]}"
name_file="/sys/class/input/$(basename "$dev")/device/name"

if [[ ! -r $name_file ]]; then
  exit 1
fi

name=$(<"$name_file")
[[ -n $name ]] || exit 1

hypr_name=$(tr '[:upper:]' '[:lower:]' <<<"$name" | tr ' ' '-')

echo "$hypr_name"
